# Server-only Supabase settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scalp-images

# Server-only Google Drive settings for scalp-analysis image storage.
SCALP_ANALYSIS_STORAGE_PROVIDER=google-drive
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Scalp analysis AI adapter.
# Use "mock" for now. Switch to "openai-5.5" after the OpenAI Vision adapter is wired with real credentials.
SCALP_ANALYSIS_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_VISION_TIMEOUT_MS=30000

# Server-only scalp AI provider settings.
# Leave SCALP_AI_PROVIDER unset or set to "heuristic" to keep local fallback-only mode.

SCALP_AI_PROVIDER=heuristic
SCALP_AI_BASE_URL=
SCALP_AI_API_KEY=
SCALP_AI_MODEL=
SCALP_AI_TIMEOUT_MS=2500
SCALP_AI_ALLOW_FALLBACK=true
