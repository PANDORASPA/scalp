# Server-only Supabase settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scalp-images

# Server-only staff login.
# Official launch requires AUTH_USERS_JSON with non-default passwords and a strong AUTH_SESSION_SECRET.
# Example:
# AUTH_USERS_JSON=[{"username":"owner","password":"change-this-long-password","name":"Owner","role":"admin"},{"username":"frontdesk","password":"change-this-too","name":"Front Desk","role":"staff"}]
AUTH_USERS_JSON=
AUTH_SESSION_SECRET=

# Server-only image storage for scalp-analysis.
# Use "demo" only for local/smoke testing before Google Drive credentials are ready.
# Official launch requires "google-drive" plus all three Google Drive values below.
SCALP_ANALYSIS_STORAGE_PROVIDER=google-drive
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Keep false for private customer images. Public mode is only needed for legacy external image consumers.
GOOGLE_DRIVE_PUBLIC_ACCESS=false

# Scalp analysis AI adapter.
# Use "mock" for flow testing. Official launch requires "openai-5.5" plus OPENAI_API_KEY.
SCALP_ANALYSIS_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_VISION_TIMEOUT_MS=30000

# Release verification helpers.
# APP_BASE_URL enables live smoke checks. SMOKE_CLEANUP deletes the smoke customer after verification.
# REQUIRE_OFFICIAL_INTEGRATIONS=true fails the gate unless auth, Google Drive, and OpenAI are in official mode.
APP_BASE_URL=
SMOKE_CLEANUP=false
REQUIRE_OFFICIAL_INTEGRATIONS=false

# Server-only scalp AI provider settings.
# Leave SCALP_AI_PROVIDER unset or set to "heuristic" to keep local fallback-only mode.

SCALP_AI_PROVIDER=heuristic
SCALP_AI_BASE_URL=
SCALP_AI_API_KEY=
SCALP_AI_MODEL=
SCALP_AI_TIMEOUT_MS=2500
SCALP_AI_ALLOW_FALLBACK=true
